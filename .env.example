# Copy to .env and fill with your Firebase web app config.
# NEVER commit .env. Debug App Check tokens are secrets too.

VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:REPLACE_ME
VITE_FIREBASE_MEASUREMENT_ID=

# App Check debug token (accepted for hackathon submissions). Do not commit real tokens.
VITE_APPCHECK_DEBUG_TOKEN=

# mock | firebase — mock runs fully offline with a deterministic planner
VITE_AI_MODE=mock

# Cloud model id when Firebase is configured (override as needed)
VITE_CLOUD_MODEL=gemini-3.5-flash-lite
